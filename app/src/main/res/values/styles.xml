<resources>
    <style name="CategoryTile">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">136dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">bottom|start</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BottomTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#85858D</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="MapMarker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/map_marker_background</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">68dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">4dp</item>
    </style>
    <style name="BottomTabActive" parent="BottomTab">
        <item name="android:textColor">#171717</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
