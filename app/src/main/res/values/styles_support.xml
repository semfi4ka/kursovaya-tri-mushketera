<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SupportSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/support_section_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">22dp</item>
    </style>

    <style name="SupportRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/nav_active</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="SupportHeading" parent="SupportRow">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="SupportHelpDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="bottomSheetStyle">@style/SupportHelpSheet</item>
    </style>

    <style name="SupportHelpSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/white</item>
        <item name="paddingBottomSystemWindowInsets">true</item>
        <item name="shapeAppearanceOverlay">@style/SupportHelpShape</item>
    </style>

    <style name="SupportHelpShape">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="SupportHelpAnswer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:button">@null</item>
        <item name="android:drawableEnd">@drawable/help_answer_indicator</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/nav_active</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
