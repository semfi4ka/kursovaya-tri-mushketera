<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/authRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F5"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="false"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/authContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/auth_button_background"
                android:gravity="center"
                android:text="П"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.04"
                android:text="ПОДРАБОТКА"
                android:textColor="#171717"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/authTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Войдите в аккаунт"
            android:textColor="#171717"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/authSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="3dp"
            android:text="Находите подработку, которая подходит именно вам"
            android:textColor="#77777F"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/loginPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_white"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/AuthFieldLabel"
                android:text="Логин или электронная почта" />

            <EditText
                android:id="@+id/loginIdentifier"
                style="@style/AuthField"
                android:autofillHints="username"
                android:hint="Введите логин или email"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="18dp"
                android:text="Пароль" />

            <EditText
                android:id="@+id/loginPassword"
                style="@style/AuthField"
                android:autofillHints="password"
                android:hint="Введите пароль"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:singleLine="true" />

            <TextView
                android:id="@+id/loginButton"
                style="@style/AuthPrimaryButton"
                android:layout_marginTop="24dp"
                android:text="Войти" />

            <TextView
                android:id="@+id/guestButton"
                style="@style/AuthSecondaryButton"
                android:layout_marginTop="10dp"
                android:text="Войти как гость" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/AuthSupportingText"
                    android:text="Впервые здесь?" />

                <TextView
                    android:id="@+id/openRegistration"
                    style="@style/AuthLink"
                    android:layout_marginStart="5dp"
                    android:text="Создать аккаунт" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/registrationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_white"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/registrationStepLabel"
                style="@style/AuthFieldLabel"
                android:text="ШАГ 1 ИЗ 2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="22dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/registrationProgressOne"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/auth_progress_active" />

                <View
                    android:id="@+id/registrationProgressTwo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/auth_progress_inactive" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/registrationStepOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                style="@style/AuthFieldLabel"
                android:text="Фамилия, имя и отчество" />

            <EditText
                android:id="@+id/registerSurname"
                style="@style/AuthField"
                android:autofillHints="familyName"
                android:hint="Фамилия"
                android:inputType="textCapWords|textPersonName"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <EditText
                android:id="@+id/registerFirstName"
                style="@style/AuthField"
                android:autofillHints="givenName"
                android:hint="Имя"
                android:inputType="textCapWords|textPersonName"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <EditText
                android:id="@+id/registerPatronymic"
                style="@style/AuthField"
                android:autofillHints="middleName"
                android:hint="Отчество (необязательно)"
                android:inputType="textCapWords|textPersonName"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="16dp"
                android:text="Дата рождения" />

            <TextView
                android:id="@+id/registerDateOfBirth"
                style="@style/AuthDateField"
                android:contentDescription="Выбрать дату рождения"
                android:text="Выберите дату"
                android:textColor="#85858D" />

            <TextView
                android:id="@+id/nextRegistrationStep"
                style="@style/AuthPrimaryButton"
                android:layout_marginTop="24dp"
                android:text="Продолжить" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/registrationStepTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                style="@style/AuthFieldLabel"
                android:text="Логин" />

            <EditText
                android:id="@+id/registerUsername"
                style="@style/AuthField"
                android:autofillHints="username"
                android:hint="Придумайте логин"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="14dp"
                android:text="Номер телефона" />

            <EditText
                android:id="@+id/registerPhone"
                style="@style/AuthField"
                android:autofillHints="phone"
                android:hint="+375 (__) ___-__-__"
                android:inputType="phone"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="14dp"
                android:text="Электронная почта" />

            <EditText
                android:id="@+id/registerEmail"
                style="@style/AuthField"
                android:autofillHints="emailAddress"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="14dp"
                android:text="Пароль" />

            <EditText
                android:id="@+id/registerPassword"
                style="@style/AuthField"
                android:autofillHints="newPassword"
                android:hint="Не менее 8 символов"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:singleLine="true" />

            <TextView
                android:id="@+id/registerButton"
                style="@style/AuthPrimaryButton"
                android:layout_marginTop="24dp"
                android:text="Зарегистрироваться" />
            </LinearLayout>

            <TextView
                android:id="@+id/previousRegistrationStep"
                style="@style/AuthLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="← Назад"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/AuthSupportingText"
                    android:text="Уже есть аккаунт?" />

                <TextView
                    android:id="@+id/openLogin"
                    style="@style/AuthLink"
                    android:layout_marginStart="5dp"
                    android:text="Войти" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
