<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F5"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/orderFeed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">
                <TextView
                    android:id="@+id/listTab"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/segmented_selected"
                    android:gravity="center"
                    android:text="Список"
                    android:textColor="#171717"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/mapTab"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/segmented_unselected"
                    android:gravity="center"
                    android:text="Карта"
                    android:textColor="#77777F"
                    android:textSize="18sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp">
                    <FrameLayout style="@style/CategoryTileFrame">
                        <ImageView android:id="@+id/categoryImage0" style="@style/CategoryTileImage" android:src="@drawable/category_uncanny" />
                        <View style="@style/CategoryTileScrim" />
                        <TextView style="@style/CategoryTileLabel" android:text="Что-то здесь\nнечисто" />
                    </FrameLayout>
                    <FrameLayout style="@style/CategoryTileFrame">
                        <ImageView android:id="@+id/categoryImage1" style="@style/CategoryTileImage" android:src="@drawable/category_work_home" />
                        <View style="@style/CategoryTileScrim" />
                        <TextView style="@style/CategoryTileLabel" android:text="Личное-\nрабочее" />
                    </FrameLayout>
                    <FrameLayout style="@style/CategoryTileFrame">
                        <ImageView android:id="@+id/categoryImage2" style="@style/CategoryTileImage" android:src="@drawable/category_surprise" />
                        <View style="@style/CategoryTileScrim" />
                        <TextView style="@style/CategoryTileLabel" android:text="Застали\nврасплох?" />
                    </FrameLayout>
                    <FrameLayout style="@style/CategoryTileFrame">
                        <ImageView android:id="@+id/categoryImage3" style="@style/CategoryTileImage" android:src="@drawable/category_email" />
                        <View style="@style/CategoryTileScrim" />
                        <TextView style="@style/CategoryTileLabel" android:text="Укажите\nпочту" />
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_white"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="12dp"
                    android:hint="Какой заказ ищете?"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="#171717"
                    android:textColorHint="#85858D"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/filterButton"
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/rounded_white"
                    android:gravity="center"
                    android:text="☷"
                    android:textColor="#171717"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="18dp">
                <include layout="@layout/item_order" />
                <include layout="@layout/item_order_second" />
                <include layout="@layout/item_order_third" />
                <include layout="@layout/item_order_fourth" />
                <include layout="@layout/item_order_fifth" />
                <include layout="@layout/item_order_sixth" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/mapContent"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/map_background"
                android:visibility="gone">

                <View android:layout_width="440dp" android:layout_height="18dp" android:layout_gravity="center" android:background="#FFFFFF" android:rotation="-22" />
                <View android:layout_width="440dp" android:layout_height="14dp" android:layout_gravity="center" android:background="#FFFFFF" android:rotation="35" />
                <View android:layout_width="18dp" android:layout_height="480dp" android:layout_gravity="center" android:background="#FFFFFF" android:rotation="18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_white"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Демонстрационная карта · заказы"
                    android:textColor="#505057"
                    android:textSize="14sp" />

                <TextView android:id="@+id/mapMarker0" style="@style/MapMarker" android:layout_gravity="top|start" android:layout_marginStart="34dp" android:layout_marginTop="108dp" android:text="300 Br" />
                <TextView android:id="@+id/mapMarker1" style="@style/MapMarker" android:layout_gravity="top|end" android:layout_marginTop="178dp" android:layout_marginEnd="28dp" android:text="Дизайн" />
                <TextView android:id="@+id/mapMarker2" style="@style/MapMarker" android:layout_gravity="center|start" android:layout_marginStart="54dp" android:text="450 Br" />
                <TextView android:id="@+id/mapMarker3" style="@style/MapMarker" android:layout_gravity="center|end" android:layout_marginEnd="36dp" android:text="80 Br" />
                <TextView android:id="@+id/mapMarker4" style="@style/MapMarker" android:layout_gravity="bottom|start" android:layout_marginStart="42dp" android:layout_marginBottom="88dp" android:text="120 Br" />
                <TextView android:id="@+id/mapMarker5" style="@style/MapMarker" android:layout_gravity="bottom|end" android:layout_marginEnd="32dp" android:layout_marginBottom="138dp" android:text="200 Br" />
            </FrameLayout>

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Ничего не найдено\nИзмени запрос или сбрось фильтры"
                android:textColor="#77777F"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/chatsPage"
        layout="@layout/page_chats"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/supportPage"
        layout="@layout/page_support"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="#FAFAFB"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout android:id="@+id/navOrders" style="@style/BottomNavigationItem" android:contentDescription="Заказы">
            <ImageView style="@style/BottomNavigationIcon" android:src="@drawable/ic_nav_orders" android:tint="@color/nav_item_tint" />
            <TextView style="@style/BottomNavigationLabel" android:text="Заказы" android:textColor="@color/nav_item_tint" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navChats" style="@style/BottomNavigationItem" android:contentDescription="@string/chats_title">
            <ImageView style="@style/BottomNavigationIcon" android:src="@drawable/ic_nav_chats" android:tint="@color/nav_item_tint" />
            <TextView style="@style/BottomNavigationLabel" android:text="@string/chats_title" android:textColor="@color/nav_item_tint" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navBalance" style="@style/BottomNavigationItem" android:contentDescription="Баланс">
            <ImageView style="@style/BottomNavigationIcon" android:src="@drawable/ic_nav_balance" android:tint="@color/nav_item_tint" />
            <TextView style="@style/BottomNavigationLabel" android:text="7 Br" android:textColor="@color/nav_item_tint" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navProfile" style="@style/BottomNavigationItem" android:contentDescription="Анкета">
            <ImageView style="@style/BottomNavigationIcon" android:src="@drawable/ic_nav_profile" android:tint="@color/nav_item_tint" />
            <TextView style="@style/BottomNavigationLabel" android:text="Анкета" android:textColor="@color/nav_item_tint" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navSupport" style="@style/BottomNavigationItem" android:contentDescription="@string/support_title">
            <ImageView style="@style/BottomNavigationIcon" android:src="@drawable/ic_nav_support" android:tint="@color/nav_item_tint" />
            <TextView style="@style/BottomNavigationLabel" android:text="@string/support_title" android:textColor="@color/nav_item_tint" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
