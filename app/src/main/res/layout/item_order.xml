<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:tag="графический дизайн иллюстрации 300 витебск дистанционно"
    android:layout_marginBottom="14dp"
    android:background="@drawable/rounded_white"
    android:orientation="vertical"
    android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19 ноября · новый заказ" android:textColor="#85858D" android:textSize="14sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Графический дизайн\nдо 300 Br" android:textColor="#171717" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:maxLines="3" android:ellipsize="end" android:text="Создание иллюстраций для настольной игры · Количество: 14 шт · Изображения: 2D · Разовая задача или временный проект" android:textColor="#29292D" android:textSize="16sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="14dp" android:orientation="horizontal">
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#C9C9CE" />
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="#A7A8AE" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="◉  Дистанционно · Витебск" android:textColor="#505057" android:textSize="16sp" />
</LinearLayout>
