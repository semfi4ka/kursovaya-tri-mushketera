<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Город"
            android:textColor="#171717"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/citySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Формат работы"
            android:textColor="#171717"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/remoteCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Дистанционно"
            android:textColor="#29292D" />

        <CheckBox
            android:id="@+id/onSiteCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="На месте"
            android:textColor="#29292D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Цена, Br"
            android:textColor="#171717"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/minPriceInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="От"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#171717" />

            <EditText
                android:id="@+id/maxPriceInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="До"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#171717" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
