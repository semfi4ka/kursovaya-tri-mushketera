<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/aboutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/about_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/nav_active"
        app:title="@string/support_about"
        app:titleTextColor="@color/nav_active" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/about_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:shrinkColumns="0,1"
                    android:stretchColumns="0">

                    <TableRow>
                        <TextView style="@style/AboutInfoLabel" android:text="@string/about_build_number" />
                        <TextView
                            android:id="@+id/aboutBuildNumber"
                            style="@style/AboutInfoValue"
                            android:text="@string/about_unknown" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/AboutInfoLabel" android:text="@string/about_build_version" />
                        <TextView
                            android:id="@+id/aboutBuildVersion"
                            style="@style/AboutInfoValue"
                            android:text="@string/about_unknown" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/AboutInfoLabel" android:text="@string/about_package_name" />
                        <TextView
                            android:id="@+id/aboutPackageName"
                            style="@style/AboutInfoValue"
                            android:text="@string/about_unknown" />
                    </TableRow>
                </TableLayout>

                <View style="@style/AboutDivider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:gravity="end"
                    android:paddingVertical="8dp"
                    android:text="@string/about_updates"
                    android:textColor="@color/nav_active"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:shrinkColumns="0,1"
                    android:stretchColumns="0">

                    <TableRow>
                        <TextView style="@style/AboutInfoLabel" android:text="@string/about_channel" />
                        <TextView
                            style="@style/AboutInfoValue"
                            android:text="@string/about_course_build" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/AboutInfoLabel" android:text="@string/about_installation" />
                        <TextView
                            style="@style/AboutInfoValue"
                            android:text="@string/about_manual_install" />
                    </TableRow>
                </TableLayout>

                <View style="@style/AboutDivider" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/aboutCopy"
                    style="@style/AboutAction"
                    android:text="@string/about_copy"
                    android:textColor="#4357AD" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/aboutCheckUpdates"
                    style="@style/AboutAction"
                    android:text="@string/about_check_updates" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/about_project_title"
                android:textColor="@color/nav_active"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/about_project_description"
                android:textColor="@color/nav_active"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/about_team"
                android:textColor="@color/nav_inactive"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
