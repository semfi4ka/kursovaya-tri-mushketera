<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:tag="фотограф семейная фотосессия брест 200 br"
    android:layout_marginBottom="14dp" android:background="@drawable/rounded_white"
    android:orientation="vertical" android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14 ноября" android:textColor="#85858D" android:textSize="14sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Семейная фотосессия" android:textColor="#171717" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ищем фотографа на прогулочную съёмку в выходной день, около двух часов." android:textColor="#29292D" android:textSize="16sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Выплата" android:textColor="#85858D" android:textSize="14sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="200 Br" android:textColor="#171717" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Адрес" android:textColor="#85858D" android:textSize="14sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Брест · На месте" android:textColor="#505057" android:textSize="16sp" />
</LinearLayout>
